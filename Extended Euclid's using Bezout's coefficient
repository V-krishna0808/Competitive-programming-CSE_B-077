import sys
def ext_gcd(a, b):
    if b==0:
        return 1,0,a
    x1,y1,d=ext_gcd(b, a % b)
    return y1,x1-(a//b)*y1,d
def solve():
    lines=sys.stdin.read().split()
    if not lines:
        return
    a,b=map(int, lines[:2])
    x,y,d=ext_gcd(a,b)
    sx,sy=b//d,a//d
    bx,by=x, y
    bval=float('inf')
    for k in range(-5,6):
        nx=x+k*sx
        ny=y-k*sy
        val=abs(nx)+abs(ny)
        if val<bval:
            bval=val
            bx,by=nx,ny
        elif val==bval and nx<=ny:
            bx,by=nx,ny
    print(bx,by,d)
if __name__ == '__main__':
    solve()
