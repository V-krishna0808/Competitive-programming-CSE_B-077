dividend, divisor = map(int, input().split())

INT_MAX = 2147483647
INT_MIN = -2147483648

# Overflow case
if dividend == INT_MIN and divisor == -1:
    print(INT_MAX)
    exit()

negative = (dividend < 0) ^ (divisor < 0)

dvd = abs(dividend)
dvs = abs(divisor)

quotient = 0

while dvd >= dvs:
    temp = dvs
    multiple = 1

    while dvd >= (temp << 1):
        temp <<= 1
        multiple <<= 1

    dvd -= temp
    quotient += multiple

if negative:
    quotient = -quotient

print(quotient)
